#!/usr/bin/env bash
set -eu

export XDG_CURRENT_DESKTOP=LXDE
xset s off
xset s noblank
xset -dpms
openbox --config-file /usr/local/share/weather-station/openbox.xml &
lxpolkit &
while [ ! -f "$HOME/.weather-station-setup-complete" ]; do
    xterm -name weather-station-first-boot -T "Weather Station First Boot Setup" \
        -e /usr/local/bin/weather-station-first-boot || true
done
pcmanfm --desktop --profile weather-station &
DESKTOP_PID=$!
/usr/local/bin/weather-station-launch &
wait "$DESKTOP_PID"
