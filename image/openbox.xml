<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
  </focus>
  <keyboard>
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <keybind key="C-A-e">
      <action name="Execute">
        <command>/usr/local/bin/weather-station-settings</command>
      </action>
    </keybind>
    <keybind key="C-A-w">
      <action name="Execute">
        <command>xterm -T "Wi-Fi Settings" -e nmtui</command>
      </action>
    </keybind>
    <keybind key="C-A-s">
      <action name="Execute">
        <command>/usr/local/bin/weather-station-launch</command>
      </action>
    </keybind>
  </keyboard>
  <mouse>
    <context name="Titlebar">
      <mousebind button="Left" action="Drag">
        <action name="Move"/>
      </mousebind>
    </context>
  </mouse>
</openbox_config>
