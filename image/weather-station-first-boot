#!/usr/bin/env bash
set -euo pipefail

MARKER="$HOME/.weather-station-setup-complete"
[ -f "$MARKER" ] && exit 0

printf '%s\n' "Welcome. Connect to Wi-Fi to set up the weather station."

while true; do
    read -r -p "Press Enter to open Wi-Fi setup. "
    nmtui
    if /usr/local/bin/weather-station-setup; then
        break
    fi
    printf 'Station setup did not complete. Check Wi-Fi and try again.\n'
done

touch "$MARKER"
printf '\nSetup is complete. Starting the weather station.\n'
